# Fill these in, then `source 00-vars.env` before running the other scripts
# on each node (or just export them manually over SSH).

NODE1_IP=192.168.1.101   # first node — the one you run 01-bootstrap-node1.sh on
NODE2_IP=192.168.1.102
NODE3_IP=192.168.1.103

# A FREE, unused LAN IP — not handed out by your router's DHCP, not in use
# by anything else. This becomes the floating control-plane VIP that all
# 3 nodes share via ARP, so the cluster has one stable entrypoint that
# survives any single node going down. Exclude it from your DHCP pool.
VIP=192.168.1.100

# Network interface each VM uses for its LAN IP. Check with: ip -4 addr
INTERFACE=eth0

# kube-vip version. Check the latest at:
# https://github.com/kube-vip/kube-vip/releases
KVVERSION=v0.8.9
